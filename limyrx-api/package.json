{
    "name": "limyrx-api",
    "private": true,
    "version": "0.1.0",
    "description": "Limyrx Client stats API — telemetry heartbeat, public stats and admin dashboard backend.",
    "license": "MIT",
    "main": "./dist/index.js",
    "scripts": {
        "compile": "esbuild --target=node22 --platform=node --format=cjs --packages=external --sourcemap --bundle --outfile=dist/index.js src/index.ts",
        "check": "tsc --noEmit --project tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "fmt": "oxfmt -c ../.oxfmtrc.json .",
        "lint": "oxlint -c ./node_modules/@xmcl/oxlint-config/oxlintrc.json ."
    },
    "engines": {
        "node": ">=22.16.0"
    },
    "dependencies": {
        "@fastify/cors": "^11.0.1",
        "@fastify/jwt": "^10.2.1",
        "bcryptjs": "^3.0.2",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.1",
        "fastify-plugin": "^5.0.1",
        "mongoose": "^8.9.5"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@xmcl/oxlint-config": "workspace:*",
        "esbuild": "^0.28.1",
        "oxfmt": "^0.48.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    }
}
