# MongoDB admin/root credentials (used to create the initial user)
MONGO_ROOT_USER=limyrx
MONGO_ROOT_PASSWORD=change-me-root

# MongoDB application user/password (the API connects with this)
MONGO_APP_USER=limyrx
MONGO_APP_PASSWORD=change-me-app

# JWT secret for admin dashboard sessions — generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt

# One-time token required by POST /api/v1/auth/bootstrap (create first admin)
# Generate with: openssl rand -hex 24
ADMIN_BOOTSTRAP_TOKEN=change-me-bootstrap

# GitHub repo for release download counts
GITHUB_REPO=ILMaRkz-Y/Limyrx-Client
# Optional GitHub token to avoid rate limits (read-only fine)
GITHUB_TOKEN=

# CORS origin for the dashboard (the launcher sends no Origin header).
# Set to the dashboard URL in production, e.g. https://api.limyrx.online
CORS_ORIGIN=*
